  "hooks": [
    {
      "event": "SessionStart",
      "matcher": "compact",
      "command": "{{PYTHON}}",
      "args": [
        "{{CLONE}}/base/hooks/compact_history.py"
      ],
      "timeout": 30,
      "statusMessage": "Saving pre-compaction history"
    },
    {
      "event": "SessionStart",
      "matcher": "",
      "command": "bash",
      "args": [
        "{{CLONE}}/base/hooks/project-tmp.sh"
      ],
      "timeout": 60
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "command": "{{PYTHON}}",
      "args": [
        "{{CLONE}}/base/hooks/no_ampersand.py"
      ]
    }
  ],
  "settings": [
    {
      "key": "attribution",
      "value": {
        "commit": "",
        "pr": ""
      }
    },
    {
      "key": "env.CLAUDE_CODE_USE_POWERSHELL_TOOL",
      "value": "0",
      "platform": "windows"
