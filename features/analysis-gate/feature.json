{
  "name": "analysis-gate",
  "description": "Requires a fresh analysis file before agent launches and time estimates: blocks Agent launches without it, and the reflection flags estimates without it.",
  "translations": {
    "ru": {
      "description": "Требует свежий файл разбора перед запуском агентов и оценкой сроков: без него запуск Agent блокируется, а рефлексия отмечает названный срок."
    }
  },
  "enabledByDefault": false,
  "platforms": [
    "linux",
    "windows",
    "darwin"
  ],
  "dependencies": [],
  "rules": [
    {
      "path": "rules/claude-analysis-gate.md",
      "target": "claude",
      "whenEnabled": [
        "analysis-gate"
      ]
    }
  ],
  "hooks": [
    {
      "event": "PreToolUse",
      "matcher": "Agent",
      "command": "{{PYTHON}}",
      "args": [
        "{{CLONE}}/features/analysis-gate/hooks/analysis_gate.py"
      ],
      "timeout": 30,
      "statusMessage": "Checking the analysis file",
      "translations": {
        "ru": {
          "statusMessage": "Проверка файла анализа"
        }
      }
    }
  ],
  "settings": [],
  "plugins": [],
  "files": [
    "hooks/analysis_gate.py",
    "hooks/analysis_file.py"
  ],
  "assets": [],
  "agents": [],
  "skills": [],
  "hubCommands": [],
  "programs": []
}
